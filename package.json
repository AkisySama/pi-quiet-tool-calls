{
  "name": "pi-quiet-tool-calls",
  "version": "2.0.0",
  "description": "Quiet tool display for pi: collapse bash/read/write/edit/grep/find/ls into one-line status rows with per-tool icons, summaries, live spinner, result stats and error codes",
  "keywords": [
    "pi-package",
    "pi",
    "extension",
    "tui",
    "quiet",
    "minimal",
    "tool-call",
    "status-line"
  ],
  "author": "AkisySama",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/AkisySama/pi-quiet-tool-calls.git"
  },
  "homepage": "https://github.com/AkisySama/pi-quiet-tool-calls#readme",
  "bugs": {
    "url": "https://github.com/AkisySama/pi-quiet-tool-calls/issues"
  },
  "license": "MIT",
  "pi": {
    "extensions": [
      "./extensions/quiet-tools.ts"
    ]
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*"
  },
  "devDependencies": {
    "jiti": "^2.7.0"
  },
  "scripts": {
    "test": "node tests/smoke.mjs && node tests/render.mjs"
  }
}
